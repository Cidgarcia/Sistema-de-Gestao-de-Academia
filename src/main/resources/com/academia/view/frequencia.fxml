<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.academia.controller.FrequenciaController"
      spacing="20" style="-fx-background-color: #0F172A; -fx-padding: 30;">

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- PAINEL ESQUERDO: Controle de Acesso -->
        <VBox alignment="CENTER" spacing="20" style="-fx-background-color: #1E293B; -fx-background-radius: 10; -fx-padding: 40;" HBox.hgrow="ALWAYS">
            <Label text="📇" style="-fx-font-size: 64px; -fx-text-fill: #38BDF8;" />
            <Label text="Controle de Acesso" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" />
            <Label text="Digite o número da matrícula ou CPF do aluno." 
                   wrapText="true" textAlignment="CENTER" style="-fx-text-fill: #B5C4C2; -fx-font-size: 14px; -fx-padding: 0 20 0 20;" />
            
            <TextField fx:id="txtBusca" promptText="Matrícula / CPF e Enter"
                       onAction="#onBuscaRealizada"
                       style="-fx-background-color: transparent; -fx-border-color: #45D6A4; -fx-border-radius: 6;
                              -fx-border-width: 2; -fx-text-fill: #45D6A4; -fx-font-size: 18px; -fx-padding: 15;
                              -fx-alignment: center;" />
                              
            <Label fx:id="lblAguardando" text="((•)) Aguardando leitura..." style="-fx-text-fill: #45D6A4; -fx-font-size: 12px;" />
        </VBox>

        <!-- PAINEL DIREITO: Status do Acesso -->
        <VBox fx:id="vboxStatus" alignment="CENTER" spacing="15" 
              style="-fx-background-color: #1E293B; -fx-background-radius: 10; -fx-padding: 40;" HBox.hgrow="ALWAYS">
            
            <!-- Avatar/Ícone do Aluno -->
            <Label fx:id="lblAvatar" text="👤" style="-fx-font-size: 80px; -fx-text-fill: #B5C4C2;
                                                     -fx-background-color: #243247; -fx-background-radius: 100;
                                                     -fx-padding: 20; -fx-min-width: 140; -fx-min-height: 140; 
                                                     -fx-alignment: center;" />
                                                     
            <Label fx:id="lblStatusAcesso" text="Aguardando..." 
                   wrapText="true" textAlignment="CENTER"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #B5C4C2;" />
                   
            <Label fx:id="lblNomeAluno" text="-" 
                   style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-weight: bold;" />
                   
            <HBox alignment="CENTER" spacing="15">
                <Label fx:id="lblMatriculaCpf" text="ID/CPF: -" 
                       style="-fx-background-color: #243247; -fx-text-fill: #DCE7E4; -fx-padding: 5 10 5 10; -fx-background-radius: 5;" />
                <Label fx:id="lblDetalhePlano" text="Plano: -" wrapText="true"
                       style="-fx-background-color: #243247; -fx-text-fill: #DCE7E4; -fx-padding: 5 10 5 10; -fx-background-radius: 5;" />
            </HBox>
        </VBox>
    </HBox>

    <!-- PAINEL INFERIOR: Histórico Recente -->
    <VBox spacing="10" style="-fx-background-color: #1E293B; -fx-background-radius: 10; -fx-padding: 20;" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT">
            <Label text="🕒 Histórico de Entradas" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #DCE7E4;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblHistorico" text="Últimas 10 entradas" style="-fx-text-fill: #B5C4C2;" />
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <TextField fx:id="txtFiltroAluno" promptText="CPF ou matrícula do aluno" onAction="#consultarHistorico" HBox.hgrow="ALWAYS" />
            <DatePicker fx:id="dataInicioFiltro" promptText="Início" prefWidth="145" />
            <DatePicker fx:id="dataFimFiltro" promptText="Fim" prefWidth="145" />
            <Button text="Buscar" onAction="#consultarHistorico" />
            <Button text="Últimas 10" onAction="#limparFiltro" />
        </HBox>
        
        <TableView fx:id="tabelaHistorico" VBox.vgrow="ALWAYS" style="-fx-base: #1E293B; -fx-control-inner-background: #0F172A; -fx-table-cell-border-color: transparent;">
            <!-- A Tabela terá colunas configuradas via Controller para melhor customização das tags verdes/vermelhas -->
        </TableView>
    </VBox>

</VBox>
