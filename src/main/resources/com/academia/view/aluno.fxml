<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    aluno.fxml — UC 01: Cadastrar Aluno
    Controller: com.academia.controller.AlunoController
-->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.academia.controller.AlunoController"
            style="-fx-padding: 16;">

    <!-- ── Formulário (esquerda) ──────────────────────────────────── -->
    <left>
        <ScrollPane fx:id="painelCadastro" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" focusTraversable="false"
                    prefWidth="360" style="-fx-background-color: transparent; -fx-background: transparent;">
          <content>
            <VBox spacing="12" style="-fx-padding: 0 16 0 0;">

            <Label text="Cadastro de Aluno"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #38BDF8;"/>
            <Separator/>

            <Label text="Nome *" style="-fx-text-fill: #DCE7E4;"/>
            <TextField fx:id="campNome" promptText="Nome completo"/>

            <Label text="CPF" style="-fx-text-fill: #DCE7E4;"/>
            <TextField fx:id="campCpf" promptText="000.000.000-00"/>

            <Label text="Endereço:" />
            <TextField fx:id="campEndereco" promptText="Ex: Rua Principal, 123 - Bairro" />

            <Label text="E-mail" style="-fx-text-fill: #DCE7E4;"/>
            <TextField fx:id="campEmail" promptText="email@exemplo.com"/>

            <Label text="Telefone" style="-fx-text-fill: #DCE7E4;"/>
            <TextField fx:id="campTelefone" promptText="(00) 00000-0000"/>

            <Label text="Data de Nascimento" style="-fx-text-fill: #DCE7E4;"/>
            <DatePicker fx:id="campDataNascimento" maxWidth="Infinity"/>

            <Label text="Observações" style="-fx-text-fill: #DCE7E4;"/>
            <TextArea fx:id="campObservacoes" promptText="Observações gerais..."
                      prefRowCount="3" wrapText="true"/>

            <Separator/>

            <!-- Botões de ação -->
            <HBox spacing="8">
                <Button fx:id="btnSalvarAluno" text="💾 Salvar" onAction="#onSalvarClicado" styleClass="accent"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="🗑 Excluir" onAction="#onExcluirClicado" styleClass="danger"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="➕ Novo" onAction="#onNovoClicado"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Mensagem de status -->
            <Label fx:id="labelStatus" text="" wrapText="true"
                   style="-fx-text-fill: #45D6A4; -fx-font-size: 12px;"/>
            </VBox>
          </content>
        </ScrollPane>
    </left>

    <!-- ── Tabela (direita) ───────────────────────────────────────── -->
    <center>
        <VBox spacing="0">
            <!-- ── Cabeçalho (Controles) ─────────────────────────────────────────────────── -->
            <VBox style="-fx-padding: 0 0 12 0; -fx-background-color: transparent;" VBox.vgrow="NEVER">
                
                <Label text="Alunos"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 0 0 16 0;"/>

                <HBox alignment="CENTER_LEFT" spacing="16">
                    <Label text="Pesquisar:" style="-fx-text-fill: #DCE7E4;"/>
                    <TextField fx:id="campPesquisa"
                               promptText="Nome do aluno..."
                               style="-fx-background-color: #1E293B;
                                      -fx-border-color: #334155; -fx-border-radius: 20;
                                      -fx-background-radius: 20;
                                      -fx-text-fill: #E6F0ED; -fx-prompt-text-fill: #475569;
                                      -fx-padding: 7 16 7 16; -fx-pref-width: 280;" HBox.hgrow="ALWAYS"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Filtros de status -->
                <VBox spacing="8" style="-fx-padding: 10 0 0 0;">
                  <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="btnTodos" text="● Todos" onAction="#onFiltroTodos"
                            style="-fx-background-color: #047857; -fx-text-fill: white;
                                   -fx-border-radius: 20; -fx-background-radius: 20;
                                   -fx-padding: 4 16 4 16; -fx-cursor: hand; -fx-font-size: 12;"/>
                    <Button fx:id="btnAtivos"        text="Ativos"        onAction="#onFiltroAtivos"
                            style="-fx-background-color: transparent; -fx-text-fill: #B5C4C2;
                                   -fx-border-color: #334155; -fx-border-radius: 20;
                                   -fx-background-radius: 20; -fx-padding: 4 16 4 16;
                                   -fx-cursor: hand; -fx-font-size: 12;"/>
                    <Button fx:id="btnCancelados"    text="Cancelados"    onAction="#onFiltroCancelados"
                            style="-fx-background-color: transparent; -fx-text-fill: #B5C4C2;
                                   -fx-border-color: #334155; -fx-border-radius: 20;
                                   -fx-background-radius: 20; -fx-padding: 4 16 4 16;
                                   -fx-cursor: hand; -fx-font-size: 12;"/>

                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="labelContador" text="0 registros"
                           style="-fx-text-fill: #B5C4C2; -fx-font-size: 12; -fx-padding: 0 0 0 10;"/>
                  </HBox>
                  <HBox alignment="CENTER_RIGHT">
                      <Button fx:id="btnCancelarMatricula" text="✗ Cancelar Matrícula" onAction="#onCancelarMatriculaClicado"
                              style="-fx-background-color: transparent;
                                     -fx-border-color: #da3633; -fx-border-radius: 6;
                                     -fx-background-radius: 6; -fx-text-fill: #f85149;
                                     -fx-padding: 7 14 7 14; -fx-cursor: hand;"/>
                  </HBox>
                </VBox>
            </VBox>

            <Separator style="-fx-background-color: #243247;"/>

            <!-- ── Tabela principal ───────────────────────────────────────────── -->
            <TableView fx:id="tabelaAlunos" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #0F172A;">
                <columns>
                    <TableColumn fx:id="colId"          text="ID"           prefWidth="40"/>
                    <TableColumn fx:id="colNome"        text="Nome"         prefWidth="130"/>
                    <TableColumn fx:id="colCpf"         text="CPF"          prefWidth="100"/>
                    <TableColumn fx:id="colEndereco"    text="Endereço"     prefWidth="150"/>
                    <TableColumn fx:id="colEmail"       text="E-mail"       prefWidth="130"/>
                    <TableColumn fx:id="colTelefone"    text="Telefone"     prefWidth="110"/>
                    <TableColumn fx:id="colDataNasc"    text="Nascimento"   prefWidth="90"/>
                    <TableColumn fx:id="colMatriculaId" text="Matrícula"    prefWidth="70"/>
                    <TableColumn fx:id="colPlano"       text="Plano Atual"  prefWidth="110"/>
                    <TableColumn fx:id="colInicio"      text="Início"       prefWidth="85"/>
                    <TableColumn fx:id="colFim"         text="Término"      prefWidth="85"/>
                    <TableColumn fx:id="colStatus"      text="Situação"     prefWidth="100"/>
                </columns>
                <placeholder>
                    <Label text="Nenhum aluno ou matrícula encontrada."
                           style="-fx-text-fill: #B5C4C2; -fx-font-size: 14;"/>
                </placeholder>
            </TableView>
        </VBox>
    </center>

</BorderPane>
