<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    aluno.fxml — UC 01: Cadastrar Aluno
    Controller: com.academia.controller.AlunoController
-->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.academia.controller.AlunoController"
            style="-fx-padding: 16;">

    <!-- ── Formulário (esquerda) ──────────────────────────────────── -->
    <left>
        <VBox spacing="12" style="-fx-padding: 0 20 0 0; -fx-pref-width: 340px;">

            <Label text="Cadastro de Aluno"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #58a6ff;"/>
            <Separator/>

            <Label text="Nome *" style="-fx-text-fill: #c9d1d9;"/>
            <TextField fx:id="campNome" promptText="Nome completo"/>

            <Label text="CPF" style="-fx-text-fill: #c9d1d9;"/>
            <TextField fx:id="campCpf" promptText="000.000.000-00"/>

            <Label text="E-mail" style="-fx-text-fill: #c9d1d9;"/>
            <TextField fx:id="campEmail" promptText="email@exemplo.com"/>

            <Label text="Telefone" style="-fx-text-fill: #c9d1d9;"/>
            <TextField fx:id="campTelefone" promptText="(00) 00000-0000"/>

            <Label text="Data de Nascimento" style="-fx-text-fill: #c9d1d9;"/>
            <DatePicker fx:id="campDataNascimento" style="-fx-pref-width: 300px;"/>

            <Label text="Observações" style="-fx-text-fill: #c9d1d9;"/>
            <TextArea fx:id="campObservacoes" promptText="Observações gerais..."
                      prefRowCount="3" wrapText="true"/>

            <Separator/>

            <!-- Botões de ação -->
            <HBox spacing="8">
                <Button text="💾 Salvar"   onAction="#onSalvarClicado"  styleClass="accent"   HBox.hgrow="ALWAYS"/>
                <Button text="🗑 Excluir"  onAction="#onExcluirClicado" styleClass="danger"   HBox.hgrow="ALWAYS"/>
                <Button text="➕ Novo"    onAction="#onNovoClicado"     HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Mensagem de status -->
            <Label fx:id="labelStatus" text="" wrapText="true"
                   style="-fx-text-fill: #3fb950; -fx-font-size: 12px;"/>
        </VBox>
    </left>

    <!-- ── Tabela (direita) ───────────────────────────────────────── -->
    <center>
        <VBox spacing="0">
            <!-- ── Cabeçalho (Controles) ─────────────────────────────────────────────────── -->
            <VBox style="-fx-padding: 0 0 12 0; -fx-background-color: transparent;" VBox.vgrow="NEVER">
                
                <Label text="Alunos"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white; -fx-padding: 0 0 16 0;"/>

                <HBox alignment="CENTER_LEFT" spacing="16">
                    <Label text="Pesquisar:" style="-fx-text-fill: #c9d1d9;"/>
                    <TextField fx:id="campPesquisa"
                               promptText="Nome do aluno..."
                               style="-fx-background-color: #161b22;
                                      -fx-border-color: #30363d; -fx-border-radius: 20;
                                      -fx-background-radius: 20;
                                      -fx-text-fill: #e6edf3; -fx-prompt-text-fill: #484f58;
                                      -fx-padding: 7 16 7 16; -fx-pref-width: 280;" HBox.hgrow="ALWAYS"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Filtros de status -->
                <HBox spacing="8" style="-fx-padding: 10 0 0 0;" alignment="CENTER_LEFT">
                    <Button fx:id="btnTodos"         text="● Todos"       onAction="#onFiltroTodos"
                            style="-fx-background-color: #238636; -fx-text-fill: white;
                                   -fx-border-radius: 20; -fx-background-radius: 20;
                                   -fx-padding: 4 16 4 16; -fx-cursor: hand; -fx-font-size: 12;"/>
                    <Button fx:id="btnAtivos"        text="Ativos"        onAction="#onFiltroAtivos"
                            style="-fx-background-color: transparent; -fx-text-fill: #8b949e;
                                   -fx-border-color: #30363d; -fx-border-radius: 20;
                                   -fx-background-radius: 20; -fx-padding: 4 16 4 16;
                                   -fx-cursor: hand; -fx-font-size: 12;"/>
                    <Button fx:id="btnCancelados"    text="Cancelados"    onAction="#onFiltroCancelados"
                            style="-fx-background-color: transparent; -fx-text-fill: #8b949e;
                                   -fx-border-color: #30363d; -fx-border-radius: 20;
                                   -fx-background-radius: 20; -fx-padding: 4 16 4 16;
                                   -fx-cursor: hand; -fx-font-size: 12;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Botão cancelar matrícula -->
                    <Button text="✗ Cancelar Matrícula" onAction="#onCancelarMatriculaClicado"
                            style="-fx-background-color: transparent;
                                   -fx-border-color: #da3633; -fx-border-radius: 6;
                                   -fx-background-radius: 6; -fx-text-fill: #f85149;
                                   -fx-padding: 7 14 7 14; -fx-cursor: hand;"/>
                                   
                    <!-- Contador de registros -->
                    <Label fx:id="labelContador" text="0 registros"
                           style="-fx-text-fill: #8b949e; -fx-font-size: 12; -fx-padding: 0 0 0 10;"/>
                </HBox>
            </VBox>

            <Separator style="-fx-background-color: #21262d;"/>

            <!-- ── Tabela principal ───────────────────────────────────────────── -->
            <TableView fx:id="tabelaAlunos" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #0d1117;">
                <columns>
                    <TableColumn fx:id="colId"          text="ID"           prefWidth="40"/>
                    <TableColumn fx:id="colNome"        text="Nome"         prefWidth="130"/>
                    <TableColumn fx:id="colCpf"         text="CPF"          prefWidth="100"/>
                    <TableColumn fx:id="colEmail"       text="E-mail"       prefWidth="130"/>
                    <TableColumn fx:id="colTelefone"    text="Telefone"     prefWidth="110"/>
                    <TableColumn fx:id="colDataNasc"    text="Nascimento"   prefWidth="90"/>
                    <TableColumn fx:id="colMatriculaId" text="Matrícula"    prefWidth="70"/>
                    <TableColumn fx:id="colPlano"       text="Plano Atual"  prefWidth="110"/>
                    <TableColumn fx:id="colInicio"      text="Início"       prefWidth="85"/>
                    <TableColumn fx:id="colFim"         text="Término"      prefWidth="85"/>
                    <TableColumn fx:id="colStatus"      text="Situação"     prefWidth="100"/>
                </columns>
                <placeholder>
                    <Label text="Nenhum aluno ou matrícula encontrada."
                           style="-fx-text-fill: #8b949e; -fx-font-size: 14;"/>
                </placeholder>
            </TableView>
        </VBox>
    </center>

</BorderPane>

