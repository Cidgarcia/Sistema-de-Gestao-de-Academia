<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    relatorio.fxml — Módulo de Relatórios Gerenciais (Design System GymCore)
    Controller: com.academia.controller.RelatorioController
-->
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.academia.controller.RelatorioController"
            stylesheets="@gymcore.css"
            style="-fx-background-color: #0F172A; -fx-padding: 20;">

    <!-- ── Topo: Título, Breadcrumbs, Ações e Filtros ─────────────── -->
    <top>
        <VBox spacing="16">
            <!-- Breadcrumbs e Ações de Topo -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="Relatórios" style="-fx-text-fill: #45D6A4; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label text="›" style="-fx-text-fill: #83939A; -fx-font-size: 13px;"/>
                        <Label text="Consultas e Exportação" style="-fx-text-fill: #94A3B8; -fx-font-size: 13px;"/>
                    </HBox>
                    <Label text="Central de Relatórios Gerenciais"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #DCE7E4;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Botões de Ação Principais -->
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button fx:id="btnFiltrar" text="🔍 Atualizar Consulta" onAction="#onFiltrarClicado"
                            styleClass="gymcore-btn-secondary"/>
                    <Button fx:id="btnLimparFiltros" text="🔄 Limpar Filtros" onAction="#onLimparFiltrosClicado"
                            styleClass="gymcore-btn-secondary"/>
                    <Button fx:id="btnExportarPdf" text="📄 Exportar PDF" onAction="#onExportarPdfClicado"
                            styleClass="gymcore-btn-primary"/>
                </HBox>
            </HBox>

            <!-- Card de Filtros -->
            <VBox styleClass="gymcore-card" spacing="12" style="-fx-padding: 16;">
                <!-- Linha 1: Seletor do Tipo de Relatório -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Tipo de Relatório:" style="-fx-font-weight: bold; -fx-text-fill: #DCE7E4; -fx-font-size: 13px;"/>
                    <ComboBox fx:id="comboTipoRelatorio" prefWidth="250" styleClass="gymcore-input"/>
                    
                    <Region HBox.hgrow="ALWAYS"/>
                    
                    <!-- Busca rápida por texto -->
                    <HBox alignment="CENTER_LEFT" spacing="8" prefWidth="340">
                        <TextField fx:id="campBuscaTexto" promptText="🔍 Pesquisar por nome ou CPF..."
                                   maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="gymcore-input"/>
                    </HBox>
                </HBox>

                <!-- Linha 2: Filtros Dinâmicos e Atalhos de Período -->
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <!-- Filtro por Período de Datas -->
                    <HBox fx:id="boxPeriodo" alignment="CENTER_LEFT" spacing="8">
                        <Label text="Período:" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                        <DatePicker fx:id="dpInicio" promptText="Data Inicial" prefWidth="125" styleClass="gymcore-input"/>
                        <Label text="até" style="-fx-text-fill: #83939A; -fx-font-size: 12px;"/>
                        <DatePicker fx:id="dpFim" promptText="Data Final" prefWidth="125" styleClass="gymcore-input"/>

                        <!-- Atalhos Rápidos (Pills) -->
                        <Button text="Hoje" onAction="#onAtalhoHoje" styleClass="gymcore-btn-pill"/>
                        <Button text="7 Dias" onAction="#onAtalho7Dias" styleClass="gymcore-btn-pill"/>
                        <Button text="Este Mês" onAction="#onAtalhoEsteMes" styleClass="gymcore-btn-pill"/>
                    </HBox>

                    <!-- Filtro Específico 1: Plano -->
                    <HBox fx:id="boxFiltroPlano" alignment="CENTER_LEFT" spacing="6">
                        <Label text="Plano:" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                        <ComboBox fx:id="comboPlano" prefWidth="150" styleClass="gymcore-input"/>
                    </HBox>

                    <!-- Filtro Específico 2: Situação Matrícula -->
                    <HBox fx:id="boxFiltroSituacao" alignment="CENTER_LEFT" spacing="6">
                        <Label text="Situação:" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                        <ComboBox fx:id="comboSituacao" prefWidth="130" styleClass="gymcore-input"/>
                    </HBox>

                    <!-- Filtro Específico 3: Forma Pagamento -->
                    <HBox fx:id="boxFiltroFormaPagamento" alignment="CENTER_LEFT" spacing="6">
                        <Label text="Forma:" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                        <ComboBox fx:id="comboFormaPagamento" prefWidth="120" styleClass="gymcore-input"/>
                    </HBox>

                    <!-- Filtro Específico 4: Tipo Pagamento -->
                    <HBox fx:id="boxFiltroTipoPagamento" alignment="CENTER_LEFT" spacing="6">
                        <Label text="Tipo:" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                        <ComboBox fx:id="comboTipoPagamento" prefWidth="140" styleClass="gymcore-input"/>
                    </HBox>

                    <!-- Filtro Específico 5: Aluno (Avaliações) -->
                    <HBox fx:id="boxFiltroAluno" alignment="CENTER_LEFT" spacing="6">
                        <Label text="Aluno:" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                        <ComboBox fx:id="comboAluno" prefWidth="170" styleClass="gymcore-input"/>
                    </HBox>
                </HBox>
            </VBox>

            <!-- Cards de Resumo e Métricas (KPIs no estilo GymCore) -->
            <HBox fx:id="boxKpiContainer" spacing="12">
                <!-- Card 1: Destaque Verde Esmeralda (GymCore Highlight) -->
                <VBox fx:id="cardKpi1" alignment="CENTER_LEFT" spacing="4"
                      styleClass="gymcore-card-highlight" style="-fx-padding: 12 16;" HBox.hgrow="ALWAYS">
                    <Label fx:id="labelKpi1Titulo" text="TOTAL DE REGISTROS"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #34D399;"/>
                    <Label fx:id="labelKpi1Valor" text="0"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #45D6A4;"/>
                </VBox>

                <!-- Card 2 -->
                <VBox fx:id="cardKpi2" alignment="CENTER_LEFT" spacing="4"
                      styleClass="gymcore-card" style="-fx-padding: 12 16;" HBox.hgrow="ALWAYS">
                    <Label fx:id="labelKpi2Titulo" text="MÉTRICA 2"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #B5C4C2;"/>
                    <Label fx:id="labelKpi2Valor" text="-"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #DCE7E4;"/>
                </VBox>

                <!-- Card 3 -->
                <VBox fx:id="cardKpi3" alignment="CENTER_LEFT" spacing="4"
                      styleClass="gymcore-card" style="-fx-padding: 12 16;" HBox.hgrow="ALWAYS">
                    <Label fx:id="labelKpi3Titulo" text="MÉTRICA 3"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #B5C4C2;"/>
                    <Label fx:id="labelKpi3Valor" text="-"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #DCE7E4;"/>
                </VBox>

                <!-- Card 4 -->
                <VBox fx:id="cardKpi4" alignment="CENTER_LEFT" spacing="4"
                      styleClass="gymcore-card" style="-fx-padding: 12 16;" HBox.hgrow="ALWAYS">
                    <Label fx:id="labelKpi4Titulo" text="MÉTRICA 4"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #B5C4C2;"/>
                    <Label fx:id="labelKpi4Valor" text="-"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #DCE7E4;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- ── Centro: Tabelas dos 5 Relatórios (Alternadas conforme tipo) ── -->
    <center>
        <StackPane style="-fx-padding: 14 0 0 0;">
            <!-- 1. Tabela: Alunos Ativos -->
            <TableView fx:id="tabelaAlunosAtivos">
                <columns>
                    <TableColumn fx:id="colAlunoAtivoId" text="ID" prefWidth="55"/>
                    <TableColumn fx:id="colAlunoAtivoNome" text="ALUNO" prefWidth="220"/>
                    <TableColumn fx:id="colAlunoAtivoCpf" text="CPF" prefWidth="130"/>
                    <TableColumn fx:id="colAlunoAtivoTelefone" text="TELEFONE" prefWidth="125"/>
                    <TableColumn fx:id="colAlunoAtivoEmail" text="E-MAIL" prefWidth="180"/>
                    <TableColumn fx:id="colAlunoAtivoPlano" text="PLANO" prefWidth="140"/>
                    <TableColumn fx:id="colAlunoAtivoInicio" text="DATA INÍCIO" prefWidth="105"/>
                    <TableColumn fx:id="colAlunoAtivoFim" text="DATA FIM" prefWidth="105"/>
                    <TableColumn fx:id="colAlunoAtivoDias" text="DIAS RESTANTES" prefWidth="115"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- 2. Tabela: Matrículas -->
            <TableView fx:id="tabelaMatriculas" visible="false">
                <columns>
                    <TableColumn fx:id="colMatriculaId" text="MATRÍCULA" prefWidth="90"/>
                    <TableColumn fx:id="colMatriculaAluno" text="ALUNO" prefWidth="220"/>
                    <TableColumn fx:id="colMatriculaCpf" text="CPF" prefWidth="130"/>
                    <TableColumn fx:id="colMatriculaPlano" text="PLANO" prefWidth="140"/>
                    <TableColumn fx:id="colMatriculaValor" text="VALOR" prefWidth="110"/>
                    <TableColumn fx:id="colMatriculaInicio" text="DATA INÍCIO" prefWidth="110"/>
                    <TableColumn fx:id="colMatriculaFim" text="DATA FIM" prefWidth="110"/>
                    <TableColumn fx:id="colMatriculaSituacao" text="SITUAÇÃO" prefWidth="110"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- 3. Tabela: Pagamentos -->
            <TableView fx:id="tabelaPagamentos" visible="false">
                <columns>
                    <TableColumn fx:id="colPagamentoId" text="ID" prefWidth="55"/>
                    <TableColumn fx:id="colPagamentoMatricula" text="MATRÍCULA" prefWidth="90"/>
                    <TableColumn fx:id="colPagamentoAluno" text="ALUNO" prefWidth="220"/>
                    <TableColumn fx:id="colPagamentoData" text="DATA PAGTO" prefWidth="115"/>
                    <TableColumn fx:id="colPagamentoTipo" text="TIPO" prefWidth="125"/>
                    <TableColumn fx:id="colPagamentoForma" text="FORMA" prefWidth="110"/>
                    <TableColumn fx:id="colPagamentoValor" text="VALOR PAGO" prefWidth="120"/>
                    <TableColumn fx:id="colPagamentoObs" text="OBSERVAÇÕES" prefWidth="180"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- 4. Tabela: Frequência -->
            <TableView fx:id="tabelaFrequencia" visible="false">
                <columns>
                    <TableColumn fx:id="colFreqId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colFreqDataHora" text="DATA / HORA ENTRADA" prefWidth="165"/>
                    <TableColumn fx:id="colFreqAluno" text="ALUNO" prefWidth="230"/>
                    <TableColumn fx:id="colFreqCpf" text="CPF" prefWidth="130"/>
                    <TableColumn fx:id="colFreqMatPlano" text="MATRÍCULA / PLANO" prefWidth="180"/>
                    <TableColumn fx:id="colFreqStatus" text="STATUS ACESSO" prefWidth="110"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <!-- 5. Tabela: Avaliações Físicas -->
            <TableView fx:id="tabelaAvaliacoes" visible="false">
                <columns>
                    <TableColumn fx:id="colAvId" text="ID" prefWidth="55"/>
                    <TableColumn fx:id="colAvData" text="DATA" prefWidth="95"/>
                    <TableColumn fx:id="colAvAluno" text="ALUNO" prefWidth="200"/>
                    <TableColumn fx:id="colAvInstrutor" text="INSTRUTOR" prefWidth="150"/>
                    <TableColumn fx:id="colAvPeso" text="PESO" prefWidth="85"/>
                    <TableColumn fx:id="colAvAltura" text="ALTURA" prefWidth="85"/>
                    <TableColumn fx:id="colAvImc" text="IMC" prefWidth="75"/>
                    <TableColumn fx:id="colAvClassificacao" text="CLASSIFICAÇÃO" prefWidth="130"/>
                    <TableColumn fx:id="colAvGordura" text="GORDURA (%)" prefWidth="95"/>
                    <TableColumn fx:id="colAvMassa" text="MASSA MUSC." prefWidth="95"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </StackPane>
    </center>

    <!-- ── Rodapé: Status de Registros ───────────────────────────── -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10 0 0 0;">
            <Label fx:id="labelStatus" text="Carregando dados..."
                   style="-fx-font-size: 12px; -fx-text-fill: #83939A;"/>
        </HBox>
    </bottom>

</BorderPane>
